function saveDocumentContent() {
  const doc = DocumentApp.getActiveDocument();
  const text = doc.getBody().getText();
  
  PropertiesService.getDocumentProperties().setProperty('SAVED_TEXT', text);
  DocumentApp.getUi().alert("💾 Còpia de seguretat desada correctament!");
}

function autoWriteContent() {
  const savedText = PropertiesService.getDocumentProperties().getProperty('SAVED_TEXT');
  
  if (!savedText) {
    DocumentApp.getUi().alert("❌ No s'ha trobat cap text desat.");
    return;
  }
  
  const body = DocumentApp.getActiveDocument().getBody();
  body.appendParagraph("\n--- Text Recuperat ---\n" + savedText);
  DocumentApp.getUi().alert("✏️ El text s'ha recuperat i s'ha escrit al final.");
}
